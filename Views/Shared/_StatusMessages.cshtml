@* Shows one-time messages set by controllers via TempData (rendered by both layouts). *@
@{
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
}
@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="cyber-alert cyber-alert-success" role="status">@successMessage</div>
}
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="cyber-alert cyber-alert-error" role="alert">@errorMessage</div>
}
