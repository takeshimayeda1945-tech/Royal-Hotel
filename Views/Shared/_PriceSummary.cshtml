@model PriceQuote
@* Price breakdown on the booking page. Also returned by Home/Quote to refresh it while the form changes. *@
<dl class="cyber-summary">
    <div>
        <dt>ค่าห้อง @DisplayText.Money(Model.PricePerNight) × @Model.Nights คืน</dt>
        <dd>@DisplayText.Money(Model.RoomTotal)</dd>
    </div>
    @if (Model.BreakfastFee > 0)
    {
        <div>
            <dt>อาหารเช้า</dt>
            <dd>@DisplayText.Money(Model.BreakfastFee)</dd>
        </div>
    }
    @if (Model.ExtraBedFee > 0)
    {
        <div>
            <dt>เตียงเสริม</dt>
            <dd>@DisplayText.Money(Model.ExtraBedFee)</dd>
        </div>
    }
    @if (Model.SpaFee > 0)
    {
        <div>
            <dt>สปา</dt>
            <dd>@DisplayText.Money(Model.SpaFee)</dd>
        </div>
    }
    @foreach (var discount in Model.Discounts)
    {
        <div class="discount">
            <dt>@discount.Name</dt>
            <dd>−@DisplayText.Money(discount.Amount)</dd>
        </div>
    }
    <div>
        <dt>ราคาหลังส่วนลด</dt>
        <dd>@DisplayText.Money(Model.AfterDiscount)</dd>
    </div>
    <div>
        <dt>ภาษี @DisplayText.Percent(BookingOptions.TaxPercent)</dt>
        <dd>@DisplayText.Money(Model.Tax)</dd>
    </div>
    <div class="total">
        <dt>ยอดสุทธิ</dt>
        <dd>@DisplayText.Money(Model.Total)</dd>
    </div>
</dl>
@if (Model.Nights > 0 && !Model.Discounts.Any())
{
    <div class="cyber-note">ยังไม่เข้าเงื่อนไขโปรโมชั่น — ดูเงื่อนไขที่หน้าโปรโมชั่น</div>
}
