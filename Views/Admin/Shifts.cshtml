@model List<HousekeepingShift>
@{
    ViewData["Title"] = "ตารางเวรแม่บ้าน";
    var housekeepers = ViewBag.Housekeepers as List<CyberUser> ?? new();
}

<div class="cyber-section-title">Housekeeping Shifts</div>
<h2 class="cyber-heading mb-3">ตารางเวรแม่บ้าน (ตั้งแต่วันนี้)</h2>

@* The form sits above the table in one row, so the table has the full width and its delete
   buttons are always visible. *@
<div class="cyber-booking-box mb-4">
    <div class="cyber-section-title mb-2">เพิ่มเวร</div>
    @if (!housekeepers.Any())
    {
        <div class="cyber-note mt-0">ยังไม่มีผู้ใช้บทบาท Housekeeper — เพิ่มได้ที่หน้าจัดการผู้ใช้ (Super Admin)</div>
    }
    else
    {
        <form asp-action="AddShift" method="post" class="row g-2 align-items-end">
            <div class="col-md-6 col-xl-3">
                <label class="form-label" for="shiftUser">แม่บ้าน</label>
                <select id="shiftUser" name="userId" class="form-select" required>
                    @foreach (var user in housekeepers)
                    {
                        <option value="@user.Id">@user.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-6 col-xl-3">
                <label class="form-label" for="shiftDate">วันที่</label>
                <input id="shiftDate" name="date" type="date" class="form-control" min="@DateInput.ToValue(DateTime.Today)" max="@DateInput.ToValue(DateTime.Today.AddYears(1))" value="@DateInput.ToValue(DateTime.Today)" required />
            </div>
            <div class="col-md-6 col-xl-3">
                <label class="form-label" for="shiftName">ช่วงเวร</label>
                <select id="shiftName" name="shiftName" class="form-select">
                    @foreach (var name in ShiftNames.All)
                    {
                        <option value="@name">@name</option>
                    }
                </select>
            </div>
            <div class="col-md-6 col-xl-3">
                <label class="form-label" for="shiftNote">หมายเหตุ</label>
                <input id="shiftNote" name="note" class="form-control" maxlength="200" placeholder="เช่น ชั้น 3–5" />
            </div>
            <div class="col-12 col-md-4 col-xl-3 ms-auto d-grid">
                <button type="submit" class="cyber-btn">เพิ่มเวร</button>
            </div>
        </form>
    }
</div>

@if (!Model.Any())
{
    <div class="cyber-empty">ยังไม่มีเวรที่กำลังจะถึง</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-dark align-middle cyber-table">
            <thead><tr><th>วันที่</th><th>ช่วงเวร</th><th>แม่บ้าน</th><th>หมายเหตุ</th><th></th></tr></thead>
            <tbody>
                @foreach (var shift in Model)
                {
                    <tr class="@(shift.Date == DateTime.Today ? "table-active" : null)">
                        <td class="text-nowrap">@shift.Date.ToString("ddd dd/MM/yyyy", CultureInfo.InvariantCulture)</td>
                        <td class="text-nowrap">@shift.ShiftName</td>
                        <td>@shift.UserName</td>
                        <td>@shift.Note</td>
                        <td class="text-end">
                            <form asp-action="DeleteShift" method="post" data-confirm="ลบเวรของ @shift.UserName ?">
                                <input type="hidden" name="id" value="@shift.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">ลบ</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
