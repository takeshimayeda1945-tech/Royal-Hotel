@model int
@inject RolePortals Portals
@{
    // On a back-office port "home" is the role's first page; room links belong to the customer site.
    var isBackOffice = RolePortals.IsBackOffice(Portals.RoleOf(Context));
    var (title, message) = Model switch
    {
        404 => ("ไม่พบหน้าที่คุณต้องการ", "ลิงก์อาจไม่ถูกต้อง หรือหน้านี้ถูกย้ายไปแล้ว"),
        403 => ("ไม่มีสิทธิ์เข้าถึง", "บัญชีของคุณไม่มีสิทธิ์เปิดหน้านี้"),
        400 => ("คำขอไม่ถูกต้อง", "ฟอร์มอาจหมดอายุ ลองรีเฟรชหน้าแล้วทำรายการใหม่อีกครั้ง"),
        405 => ("ไม่รองรับวิธีเรียกหน้านี้", "กรุณาเปิดหน้านี้จากเมนูของเว็บไซต์"),
        429 => ("ทำรายการบ่อยเกินไป", "เพื่อความปลอดภัยของบัญชี กรุณารอประมาณ 1 นาทีแล้วลองใหม่"),
        _ => ("เกิดข้อผิดพลาด", "กรุณาลองใหม่อีกครั้ง")
    };
    ViewData["Title"] = title;
}

<div class="text-center py-4">
    <div class="error-code">@Model</div>
    <h2 class="cyber-heading mt-3">@title</h2>
    <p class="cyber-room-meta mx-auto" style="max-width: 560px;">@message</p>
    <div class="d-flex justify-content-center gap-2 flex-wrap mt-3">
        <a class="cyber-btn" asp-controller="Home" asp-action="Index">กลับหน้าหลัก</a>
        @if (Model == 429)
        {
            <a class="cyber-btn-outline" asp-controller="Home" asp-action="Login">กลับไปหน้าเข้าสู่ระบบ</a>
        }
        else if (!isBackOffice)
        {
            <a class="cyber-btn-outline" asp-controller="Home" asp-action="Rooms">ดูห้องพัก</a>
        }
    </div>
</div>
