@model HotelRoom
@{
    ViewData["Title"] = Model.Name;
    var search = ViewData["RoomSearch"] as RoomSearchModel ?? RoomSearchModel.Create();
    var capacity = Math.Max(Model.Capacity, 1);
    var guests = Math.Min(search.Guests, capacity);
    var meta = string.Join(" · ", new[] { Model.RoomType, Model.Area, $"{Model.Capacity} Guests", Model.BedType }.Where(part => !string.IsNullOrWhiteSpace(part)));
    var bookedRanges = ViewBag.BookedRanges as List<DateRange> ?? new();
    var selectedDatesTaken = ViewBag.SelectedDatesTaken is true;
    var reviews = ViewBag.Reviews as RoomReviewsViewModel ?? new();
    var showingAllReviews = Context.Request.Query["allReviews"] == "true";
}

<div class="mb-3">
    <a class="cyber-back-link" asp-action="Rooms">&larr; กลับไปหน้าห้องพักทั้งหมด</a>
</div>

<div class="row g-4 align-items-start">
    <div class="col-lg-7">
        <div class="cyber-section-title">Suite Overview</div>
        <img class="cyber-detail-image" src="@Model.DisplayImageUrl" alt="@Model.Name" onerror="this.onerror=null;this.src='@HotelRoom.PlaceholderImageUrl';" />
    </div>
    <div class="col-lg-5">
        @if (!string.IsNullOrWhiteSpace(Model.Tag))
        {
            <span class="cyber-pill">@Model.Tag</span>
        }
        <h2 class="cyber-heading mb-2">@Model.Name</h2>
        <div class="cyber-room-meta">@meta</div>
        @if (reviews.Summary is { } summary)
        {
            <a class="room-rating" href="#reviews">
                <partial name="_Stars" model="summary.Average" />
                <strong>@summary.AverageText</strong> <span>(@summary.Count รีวิว)</span>
            </a>
        }
        <div class="cyber-price">@DisplayText.Money(Model.Price) <small>/ night</small></div>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="cyber-room-desc">@Model.Description</p>
        }

        <ul class="cyber-feature-list">
            <li>@Model.BedType</li>
            <li>รองรับ @Model.Capacity คน</li>
            @if (Model.HasSpa)
            {
                <li>บริการสปา (@DisplayText.Money(BookingOptions.SpaPerSession) ต่อครั้ง)</li>
            }
            <li>อาหารเช้า (@DisplayText.Money(BookingOptions.BreakfastPerPersonPerNight) ต่อคนต่อคืน)</li>
            <li>เตียงเสริม (@DisplayText.Money(BookingOptions.ExtraBedPerNight) ต่อคืน)</li>
            @if (Model.IsDeluxe)
            {
                <li>ห้อง Deluxe: คืนวันศุกร์–เสาร์ ลด 10%</li>
            }
        </ul>

        <form asp-action="Checkout" method="get" class="cyber-booking-box mt-3">
            <input type="hidden" name="roomId" value="@Model.Id" />
            <div class="row g-2">
                <div class="col-6">
                    <label class="form-label" for="detailCheckIn">Check-in</label>
                    <input id="detailCheckIn" type="date" class="form-control" name="checkIn" value="@search.CheckIn" min="@DateInput.ToValue(DateTime.Today)" data-role="check-in" required />
                </div>
                <div class="col-6">
                    <label class="form-label" for="detailCheckOut">Check-out</label>
                    <input id="detailCheckOut" type="date" class="form-control" name="checkOut" value="@search.CheckOut" min="@DateInput.ToValue(search.CheckInDate.AddDays(1))" max="@DateInput.ToValue(search.CheckInDate.AddDays(BookingOptions.MaxNights))" data-role="check-out" data-max-nights="@BookingOptions.MaxNights" required />
                </div>
                <div class="col-12">
                    <label class="form-label" for="detailGuests">จำนวนผู้เข้าพัก</label>
                    <select id="detailGuests" name="guests" class="form-select">
                        @for (var i = 1; i <= capacity; i++)
                        {
                            <option value="@i" selected="@(i == guests)">@i คน</option>
                        }
                    </select>
                </div>
            </div>
            <p class="cyber-note mb-0 @(selectedDatesTaken ? "availability-taken" : "availability-ok")" role="status">
                @if (selectedDatesTaken)
                {
                    <text>✕ ไม่ว่างในช่วง @DisplayText.Date(search.CheckInDate) – @DisplayText.Date(search.CheckOutDate) — เลือกวันอื่น</text>
                }
                else
                {
                    <text>✓ ว่างในช่วง @DisplayText.Date(search.CheckInDate) – @DisplayText.Date(search.CheckOutDate) (@search.Nights คืน)</text>
                }
            </p>
            <button type="submit" class="cyber-btn w-100 mt-3">Reserve This Suite</button>
        </form>

        <div class="mt-3">
            <div class="cyber-section-title mb-1">ช่วงวันที่มีผู้จองแล้ว</div>
            @if (!bookedRanges.Any())
            {
                <div class="cyber-note mt-0">ยังไม่มีผู้จอง — เลือกวันได้ทุกวัน</div>
            }
            else
            {
                <ul class="booked-ranges" aria-label="ช่วงวันที่ห้องไม่ว่าง">
                    @foreach (var range in bookedRanges)
                    {
                        <li>@DisplayText.Date(range.From) – @DisplayText.Date(range.To)</li>
                    }
                </ul>
                <div class="cyber-note">วันเช็คเอาท์ของการจองหนึ่งเป็นวันเช็คอินของการจองถัดไปได้</div>
                @if (bookedRanges.Count >= (ViewBag.BookedRangesShown as int? ?? int.MaxValue))
                {
                    <div class="cyber-note">แสดง @bookedRanges.Count ช่วงที่ใกล้ที่สุด — วันที่ไกลกว่านี้ ให้เลือกวันด้านบนแล้วดูผลว่าง/ไม่ว่าง</div>
                }
            }
        </div>
    </div>
</div>

<section id="reviews" class="mt-5" aria-labelledby="reviews-title">
    <div id="reviews-title" class="cyber-section-title">Guest Reviews · รีวิวจากผู้เข้าพัก</div>
    @if (reviews.Summary is not { } total)
    {
        <div class="cyber-empty">ยังไม่มีรีวิวของห้องนี้ — ผู้เข้าพักรีวิวได้หลังเช็คเอาท์ ที่หน้า "ประวัติการจอง"</div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-md-4">
                <div class="review-summary">
                    <div class="review-average">@total.AverageText<small> / 5</small></div>
                    <partial name="_Stars" model="total.Average" />
                    <div class="cyber-note">จาก @total.Count รีวิวของผู้เข้าพักจริง</div>
                    <ul class="review-bars" aria-label="จำนวนรีวิวแยกตามดาว">
                        @for (var star = ReviewRules.MaxRating; star >= ReviewRules.MinRating; star--)
                        {
                            var count = reviews.Distribution[star - 1];
                            var width = (count * 100.0 / total.Count).ToString("0.#", CultureInfo.InvariantCulture);
                            <li>
                                <span class="review-bars-label">@star ★</span>
                                <span class="review-bars-track" aria-hidden="true"><span class="review-bars-fill" style="width: @width%"></span></span>
                                <span class="review-bars-count">@count</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
            <div class="col-md-8">
                <ul class="review-list">
                    @foreach (var review in reviews.Latest)
                    {
                        <li class="review-item">
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <partial name="_Stars" model="(double)review.Rating" />
                                <strong>@ReviewRules.RatingLabel(review.Rating)</strong>
                                <span class="cyber-note mt-0 ms-auto">@review.ReviewerName · @DisplayText.Date(review.CreatedAt)@(review.UpdatedAt != null ? " (แก้ไขแล้ว)" : "")</span>
                            </div>
                            @if (review.Comment.Length > 0)
                            {
                                <p class="review-comment">@review.Comment</p>
                            }
                        </li>
                    }
                </ul>
                @if (reviews.Latest.Count < total.Count && !showingAllReviews)
                {
                    <a class="cyber-btn-outline" asp-action="RoomDetails" asp-route-id="@Model.Id" asp-route-checkIn="@search.CheckIn" asp-route-checkOut="@search.CheckOut" asp-route-guests="@guests" asp-route-allReviews="true" asp-fragment="reviews">ดูรีวิวทั้งหมด (@total.Count)</a>
                }
                else if (reviews.Latest.Count < total.Count)
                {
                    <div class="cyber-note">แสดง @reviews.Latest.Count รีวิวล่าสุด จาก @total.Count รีวิว</div>
                }
            </div>
        </div>
    }
</section>
